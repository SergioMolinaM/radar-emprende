# Nombres, teléfonos y RUT de las personas entrevistadas: nunca al repo.
contactos.md
# Fichas de entrevistas: el repo es público y rubro + comuna identifica a una persona.
# Solo se versiona la plantilla; lo publicable sale agregado por región.
fichas/*
!fichas/plantilla.md
# Audios de entrevistas: se borran tras transcribir.
*.m4a
*.mp3
*.ogg
*.opus
*.wav
.DS_Store

# Bases oficiales descargadas (pesadas, con RUT): no se versionan; se regeneran con scripts/descargar.py
data-raw/
__pycache__/

# Sitio: dependencias y build (se regeneran con npm install / npm run build)
sitio/node_modules/
sitio/dist/
# Copias generadas por npm run datos (la fuente es datos/)
sitio/src/data/*.json

# Estado local del CLI de Netlify
sitio/.netlify/
